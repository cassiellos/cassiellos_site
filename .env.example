# ProspectFlow — Website Inbound Form
# Configure em Preview primeiro. Nunca use NEXT_PUBLIC_ para estes valores.
N8N_PROSPECT_INBOUND_WEBHOOK_URL=
N8N_PROSPECT_INBOUND_WEBHOOK_SECRET=
CONTACT_NOTIFICATION_EMAIL=cassiellosagencia@gmail.com

# Mini CRM — Neon PostgreSQL (somente servidor; hoje configurado apenas no Preview da branch de desenvolvimento)
CRM_DATABASE_URL=
# Token do health check GET /api/crm/health (Authorization: Bearer). Mínimo 32 caracteres, ex.: openssl rand -hex 32
CRM_HEALTHCHECK_TOKEN=

# Mini CRM — Login administrativo (Preview)
# CRM_ADMIN_PASSWORD_HASH: hash PBKDF2-SHA256 (pbkdf2_sha256$600000$SALTHEX$HASHHEX)
# ou hash scrypt (scrypt$16384$8$1$SALTHEX$HASHHEX). Nunca colocar senha em texto puro.
# CRM_SESSION_SECRET: 32 bytes aleatórios em hexadecimal, ex.: openssl rand -hex 32.
# Configurar como Secrets só em Preview, branch feature/mini-crm-shark-scale.
CRM_ADMIN_PASSWORD_HASH=
CRM_SESSION_SECRET=

# Mini CRM — Google Calendar OAuth 2.0 (Preview da branch exclusivamente)
# O backend Next.js acessa a API; o Neon armazena somente token criptografado (AES-256-GCM).
# Todas as variaveis apenas na branch feature/mini-crm-shark-scale; nunca usar NEXT_PUBLIC_.
# Client ID e Client Secret do cliente Web Cassiellos Mini CRM - Preview do projeto GCP dedicado.
CRM_GOOGLE_CLIENT_ID=
CRM_GOOGLE_CLIENT_SECRET=
# 32 bytes aleatorios em hex: openssl rand -hex 32. NAO colocar em GitHub/chat.
CRM_GOOGLE_ENCRYPTION_KEY=
# Hostname ESTAVEL da branch Preview, callback exato cadastrado no Google Cloud:
# https://crm.cassiellos.com.br/api/crm/google/oauth/callback (definitivo; o alias
# https://<alias-estavel-da-branch>.vercel.app continua aceito durante a transição)
CRM_GOOGLE_REDIRECT_URI=
# Agenda proprietaria autorizada pela conta OAuth; usar primary inicialmente:
CRM_GOOGLE_CALENDAR_ID=primary

# Mini CRM — Cloudflare Turnstile (Fase 3 / item 4) — Preview da branch exclusivamente
# Widget "Cassiellos Mini CRM - Agendamento" (modo Managed, hostname crm.cassiellos.com.br, plano Free).
# Site key é PÚBLICA (vai ao navegador); a secret key é Sensitive e fica só no servidor.
# Sem as duas chaves o formulário fica bloqueado (falha fechada). Chaves oficiais de TESTE
# (1x0000…/2x0000…/3x0000…) são recusadas em qualquer deploy da Vercel; use-as só em testes locais.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opcional (decisão administrativa): e-mails, separados por vírgula, isentos SOMENTE do limite de
# 3 agendamentos por e-mail em 30 dias. Não isenta da regra de uma reunião futura ativa por e-mail.
CRM_BOOKING_LIMIT_EXEMPT_EMAILS=

# Mini CRM — Meta Pixel (preparado; DESLIGADO por padrão)
# Só carrega com META_PIXEL_ENABLED=true + META_PIXEL_ID numérico, apenas nas páginas do funil
# (/agendar/*), nunca no CRM, e somente após o visitante aceitar cookies de marketing.
# O ID do Pixel/Dataset é público. A Conversions API NÃO está ativa (sem token nesta etapa).
META_PIXEL_ENABLED=
META_PIXEL_ID=
